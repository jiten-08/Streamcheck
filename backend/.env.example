DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Supabase PostgreSQL (recommended for a persistent Django server on IPv4):
# Copy the Session pooler URL from Supabase Dashboard > Connect.
# Percent-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DATABASE_CONN_MAX_AGE=600
#
# Supabase Transaction pooler (serverless deployments, port 6543):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_TRANSACTION_POOLER=True
# DATABASE_CONN_MAX_AGE=0
#
# SSL is enabled automatically for Supabase hosts. These are optional overrides:
# DATABASE_SSL_REQUIRE=True
# DATABASE_SSLMODE=require
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
